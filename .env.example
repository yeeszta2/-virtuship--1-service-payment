# Salin menjadi .env (JANGAN di-commit) dan isi nilainya
# Di cloud, isi variabel ini dari secret manager, bukan dari file
APP_ENV=local
PAYMENT_API_BASE_URL=https://sandbox.payment-partner.example/v1
PAYMENT_API_KEY=
WEBHOOK_SECRET=
DATABASE_PATH=/tmp/payments.db
PAYMENT_TIMEOUT_SECONDS=3
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SECONDS=30
